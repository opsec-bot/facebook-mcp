{
  "name": "facebook-marketplace-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "MCP server that lets Claude Code use Facebook Marketplace like you: search, view, message, save, sell",
  "bin": {
    "facebook-marketplace-mcp": "src/server.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "login": "node src/login.js",
    "pin": "node src/login.js --pin",
    "smoke": "node src/smoke.js",
    "setup": "npx playwright install chromium",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright": "^1.63.0",
    "zod": "^4.1.12"
  }
}
